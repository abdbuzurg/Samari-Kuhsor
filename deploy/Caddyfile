# Caddy, fronting both apps.
#
# Written to serve three deploy stages from one file, because rewriting the
# reverse proxy at the moment DNS goes live is exactly when a mistake is
# expensive:
#
#   TLS_MODE=off       both apps on port 80 by path. What the client tests on.
#   TLS_MODE=internal  Caddy's own CA, for a staging rehearsal.
#   TLS_MODE=auto      Let's Encrypt on the real hostnames.
#
# The path split under `off` exists because there is only one IP and no DNS: the
# site is at / and the CRM at /crm. Once hostnames exist, each gets its own
# server block and the path prefix disappears.

{
	admin off
	# NO `email` directive here, deliberately.
	#
	# It was `email {$ACME_EMAIL}`, with a comment claiming an empty value was
	# fine when TLS is off. It is not: an empty variable renders as a bare
	# `email` with no argument, which is a PARSE error. Caddy refuses the whole
	# config and crash-loops, taking the site and the CRM down with it — and
	# `{$VAR:default}` does not help, because compose sets the variable to an
	# empty string rather than leaving it unset. Found on the server, after the
	# rest of the stack was already healthy.
	#
	# The address is only ever used by Let's Encrypt, so it belongs with the TLS
	# blocks below and is added at T38 when DNS lands. Until then there is no
	# certificate to warn about.
}

(common) {
	encode zstd gzip

	header {
		# Sent regardless of TLS mode. They cost nothing over HTTP and mean the
		# headers are not something to remember to add on launch day.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# No third-party anything: fonts are self-hosted through next/font and
		# Matomo runs on our own host, so the policy can be this tight.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# ---------------------------------------------------------------------------
# TLS_MODE=off — one IP, no DNS. The client's first test.
#
# TWO PORTS, not one port split by path.
#
# The original design mounted the CRM under /crm with `handle_path`, which
# strips the prefix "so the app itself is unaware it is mounted under one".
# That unawareness IS the defect: a Next.js app that does not know its base
# path emits root-absolute asset URLs — /_next/static/chunks/*.js,
# /_next/static/media/*.woff2 — and every one of them was then routed to the
# WEBSITE container, which has no such chunks. The CRM's HTML loaded and its
# CSS, JavaScript and fonts all 404'd.
#
# Making it work under a prefix means Next's `basePath`, which is baked in at
# build time, does not apply to `fetch()` (so all eight BFF call sites would
# need rewriting), and would have to be removed again at T38 when the CRM gets
# its own hostname. That is a lot of build-time coupling for a stage that
# exists only until DNS lands.
#
# A second port costs nothing, needs no application change, and disappears on
# its own when the host-based blocks below take over. `caddy` is still the only
# service publishing anything, so the topology gate is unaffected.
# ---------------------------------------------------------------------------
:80 {
	import common
	reverse_proxy web:3001
}

:8081 {
	import common
	reverse_proxy crm:3000
}

# ---------------------------------------------------------------------------
# TLS_MODE=internal / auto — real hostnames, one server block each.
#
# These blocks are inert until SITE_HOST and CRM_HOST are set to hostnames; with
# the defaults they collapse onto :80 above and Caddy ignores the duplicates.
# Uncomment the tls directive that matches the mode when DNS lands (T38).
# ---------------------------------------------------------------------------
# {$SITE_HOST} {
# 	import common
# 	# tls internal          # TLS_MODE=internal
# 	reverse_proxy web:3001
# }
#
# {$CRM_HOST} {
# 	import common
# 	# tls internal          # TLS_MODE=internal
# 	reverse_proxy crm:3000
#
# 	# The CRM is staff-only and must never be indexed, even accidentally.
# 	header /robots.txt Content-Type text/plain
# 	respond /robots.txt "User-agent: *\nDisallow: /\n" 200
# }
