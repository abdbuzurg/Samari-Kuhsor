{
  "name": "samari-kuhsor-platform",
  "private": true,
  "version": "0.0.0",
  "description": "QOIM LLC / Samari Kuhsor — CRM-ERP platform and corporate website",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
