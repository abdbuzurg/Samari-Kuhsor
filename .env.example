# Production environment. Copy to .env on the server and fill in.
#
# .env is NOT in the repository and must never be committed — it holds the
# database password and the service key.

# --- Database -----------------------------------------------------------------
POSTGRES_USER=samari
POSTGRES_PASSWORD=          # generate: openssl rand -base64 32
POSTGRES_DB=samari

# --- API ----------------------------------------------------------------------
# Proves a caller is one of our own BFFs. NOT an identity: it is the same for
# every request and says nothing about the user. Defence in depth behind the
# unpublished port, never the only lock.
SERVICE_KEY=                # generate: openssl rand -hex 32

# --- Addresses ----------------------------------------------------------------
# Where the site is actually reachable. While this is a bare IP, robots.txt
# disallows everything and QR payloads printed from the CRM will carry the IP —
# so set it to the real domain BEFORE printing any wrappers (D11).
PUBLIC_SITE_URL=http://203.0.113.10

# --- TLS ----------------------------------------------------------------------
#   off      plain HTTP on an IP. The client's first test.
#   internal Caddy's own CA, for a staging rehearsal.
#   auto     Let's Encrypt. Requires DNS to resolve first.
TLS_MODE=off

# Set these only when TLS_MODE is internal or auto, together with uncommenting
# the matching blocks in deploy/Caddyfile.
SITE_HOST=
CRM_HOST=
ACME_EMAIL=

# --- Analytics (optional) -----------------------------------------------------
# Self-hosted Matomo. Left empty until it exists; the site renders no analytics
# script at all without both values, and none before the visitor consents.
MATOMO_URL=
MATOMO_SITE_ID=
